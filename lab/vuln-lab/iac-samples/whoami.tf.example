# PLANT (repo-side, for infra-readiness-audit): whoAMI name-confusion.
# An aws_ami data source filtered by NAME with no `owners` pinned + most_recent = true
# will happily pick an attacker's public AMI with a matching name.
# Expected finding: NEW-AMI-NO-OWNER (repo audit). Rename to .tf only inside a throwaway repo.
data "aws_ami" "ubuntu" {
  most_recent = true
  filter {
    name   = "name"
    values = ["ubuntu/images/hvm-ssd/ubuntu-jammy-22.04-amd64-server-*"]
  }
  # owners = ["099720109477"]   # <- missing on purpose
}
